---
interface Props {
  kind?: 'stop' | 'gate' | 'note';
  label?: string;
}

const { kind = 'note', label } = Astro.props;
const defaults = { stop: 'Do not proceed', gate: 'Stop condition', note: 'Note' } as const;
---

<aside class:list={['callout', `callout-${kind}`]}>
  <p class="eyebrow">{label ?? defaults[kind]}</p>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    margin-block: var(--space-5);
    border: var(--border-thin) solid var(--rule);
    border-left-width: var(--border-thick);
    background: var(--sheet);
    font-size: var(--size-md);
    line-height: var(--leading-normal);
  }

  .callout-body :global(p) {
    margin: 0;
  }
  .callout-body :global(p + p) {
    margin-top: var(--space-2);
  }
  .callout-body :global(ul) {
    margin: 0;
    padding-left: var(--space-4);
  }

  .callout-gate {
    border-left-color: var(--pass);
    background: var(--pass-wash);
  }
  .callout-gate .eyebrow {
    color: var(--pass);
  }

  .callout-stop {
    border-left-color: var(--stop);
    background: var(--stop-wash);
  }
  .callout-stop .eyebrow {
    color: var(--stop);
  }

  .callout-note {
    border-left-color: var(--accent);
    background: var(--accent-wash);
  }
  .callout-note .eyebrow {
    color: var(--accent);
  }
</style>
