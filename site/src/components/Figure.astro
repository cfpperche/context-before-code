---
interface Props {
  caption: string;
  wide?: boolean;
}
const { caption, wide = false } = Astro.props;
---

<figure class:list={['figure', wide && 'figure-wide']}>
  <div class="figure-frame">
    <slot />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .figure {
    margin-block: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }

  .figure-frame {
    background: var(--sheet);
    border: var(--border-thin) solid var(--rule);
    padding: var(--space-5) var(--space-4);
    overflow-x: auto;
  }

  .figure-frame :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    min-width: 30rem;
  }

  figcaption {
    font-family: var(--font-display);
    font-size: var(--size-sm);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
    border-left: var(--border-thick) solid var(--rule-strong);
    padding-left: var(--space-3);
  }

  .figure-wide {
    margin-inline: calc(-1 * var(--space-5));
  }

  @media (max-width: 68rem) {
    .figure-wide {
      margin-inline: 0;
    }
  }
</style>
