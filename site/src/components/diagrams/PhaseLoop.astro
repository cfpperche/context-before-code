---
const boxes = [
  { x: 24, lines: ['Attach the skill', 'for this phase'] },
  { x: 216, lines: ['Paste the prepared', 'phase prompt'] },
  { x: 408, lines: ['Agent touches only', 'the files it names'] },
  { x: 600, lines: ['You run the gate', 'yourself'] },
];
---

<svg
  viewBox="0 0 920 380"
  role="img"
  aria-label="Each implementation phase is a loop: attach the skill, paste the prepared prompt, let the agent edit only the named files, then run the gate yourself. A red gate sends you back to the same prompt; only a green gate opens the next phase."
  class="loop-figure"
>
  <defs>
    <marker id="loop-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="arrowhead"></path>
    </marker>
    <marker id="loop-arrow-stop" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="arrowhead-stop"></path>
    </marker>
  </defs>

  {
    boxes.map((box) => (
      <g>
        <rect class="box" x={box.x} y="50" width="168" height="54"></rect>
        <text class="label" x={box.x + 84} y="72" text-anchor="middle">
          <tspan x={box.x + 84}>{box.lines[0]}</tspan>
          <tspan x={box.x + 84} dy="16">{box.lines[1]}</tspan>
        </text>
      </g>
    ))
  }

  {
    boxes.slice(0, -1).map((box) => (
      <line class="flow" x1={box.x + 168} y1="77" x2={box.x + 190} y2="77" marker-end="url(#loop-arrow)" />
    ))
  }

  <line class="flow" x1="684" y1="104" x2="684" y2="164" marker-end="url(#loop-arrow)"></line>

  <path class="diamond" d="M684 166 L762 200 L684 234 L606 200 Z"></path>
  <text class="label" x="684" y="204" text-anchor="middle">gate green?</text>

  <polyline class="flow" points="762,200 800,200 800,300 806,300" marker-end="url(#loop-arrow)"></polyline>
  <text class="edge" x="770" y="192">yes</text>

  <rect class="box box-done" x="808" y="274" width="88" height="54"></rect>
  <text class="label" x="852" y="296" text-anchor="middle">
    <tspan x="852">commit,</tspan>
    <tspan x="852" dy="16">next phase</tspan>
  </text>

  <polyline class="flow flow-back" points="684,234 684,330 300,330 300,110" marker-end="url(#loop-arrow-stop)"></polyline>
  <text class="edge" x="700" y="252">no</text>
  <text class="edge edge-back" x="492" y="350" text-anchor="middle">
    stay in the phase — you do not "fix it later"
  </text>

  <text class="note" x="24" y="24">one phase, one prompt, one human-run gate</text>
</svg>

<style>
  .box {
    fill: var(--sheet);
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .box-done {
    fill: var(--pass-wash);
    stroke: var(--pass);
  }
  .diamond {
    fill: var(--accent-wash);
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  .label {
    font-family: var(--font-display);
    font-size: 12px;
    fill: var(--ink);
  }
  .flow {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1.3;
  }
  .flow-back {
    stroke: var(--stop);
    stroke-dasharray: 5 4;
  }
  .arrowhead {
    fill: var(--ink-soft);
  }
  .arrowhead-stop {
    fill: var(--stop);
  }
  .edge {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink-soft);
  }
  .edge-back {
    fill: var(--stop);
  }
  .note {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: var(--ink-faint);
  }
</style>
