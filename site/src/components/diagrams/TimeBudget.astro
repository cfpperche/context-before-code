---
const X0 = 40;
const W = 820;
const scale = (hours: number) => (hours / 8) * W;

const blocks = [
  { hours: 1.0, label: 'Crash course', tone: 'prep' },
  { hours: 3.0, label: 'Context, research, spec, ADRs, prompts', tone: 'prep' },
  { hours: 3.25, label: 'Implementation phases', tone: 'build' },
  { hours: 0.75, label: 'Quality gate + README', tone: 'gate' },
];

let cursor = X0;
const laid = blocks.map((block) => {
  const x = cursor;
  const width = scale(block.hours);
  cursor += width;
  return { ...block, x, width };
});
const splitX = laid[2].x;
---

<svg
  viewBox="0 0 900 200"
  role="img"
  aria-label="A common eight-hour split: one hour of crash course and stack choice, three hours of context, research, spec, ADRs and prompts, three and a quarter hours of implementation, and three quarters of an hour for the quality gate. Half the clock is spent before the first passing test."
  class="budget-figure"
>
  {
    Array.from({ length: 9 }, (_, hour) => (
      <g>
        <line class="tick" x1={X0 + scale(hour)} y1="44" x2={X0 + scale(hour)} y2="52"></line>
        <text class="tick-label" x={X0 + scale(hour)} y="36" text-anchor="middle">
          {hour}h
        </text>
      </g>
    ))
  }

  {
    laid.map((block) => (
      <g>
        <rect class={`block block-${block.tone}`} x={block.x} y="56" width={block.width} height="46"></rect>
        <text class="hours" x={block.x + block.width / 2} y="84" text-anchor="middle">
          {block.hours}
        </text>
      </g>
    ))
  }

  {
    laid.map((block, i) => (
      <text
        class="block-label"
        x={i === laid.length - 1 ? block.x + block.width : block.x}
        y="120"
        text-anchor={i === laid.length - 1 ? 'end' : 'start'}
      >
        {block.label}
      </text>
    ))
  }

  <path class="bracket" d={`M40 142 v10 h${splitX - 40} v-10`}></path>
  <text class="bracket-label" x={(40 + splitX) / 2} y="172" text-anchor="middle">
    half the clock, before the first passing test
  </text>

  <path class="bracket bracket-build" d={`M${splitX} 142 v10 h${860 - splitX} v-10`}></path>
  <text class="bracket-label" x={(splitX + 860) / 2} y="172" text-anchor="middle">
    the other half, spending a spec you already own
  </text>
</svg>

<style>
  .tick {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .tick-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--ink-faint);
  }
  .block {
    stroke: var(--ink);
    stroke-width: 1.1;
  }
  .block-prep {
    fill: var(--accent-wash);
  }
  .block-build {
    fill: var(--sheet);
  }
  .block-gate {
    fill: var(--pass-wash);
  }
  .hours {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    fill: var(--ink);
  }
  .block-label {
    font-family: var(--font-display);
    font-size: 11.5px;
    fill: var(--ink-soft);
  }
  .bracket {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
  }
  .bracket-build {
    stroke: var(--rule-strong);
  }
  .bracket-label {
    font-family: var(--font-display);
    font-size: 12px;
    fill: var(--ink-soft);
  }
</style>
