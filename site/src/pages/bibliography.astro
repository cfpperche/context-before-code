---
import { getCollection, render } from 'astro:content';
import Doc from '../layouts/Doc.astro';

const entries = await getCollection('root');
const entry = entries.find((item) => item.id.toLowerCase() === 'bibliography');
if (!entry) throw new Error('BIBLIOGRAPHY.md is missing');
const { Content, headings } = await render(entry);
---

<Doc
  title="Bibliography"
  description="The published methods this routine composes, the documents behind each step, and the places where those methods disagree."
  eyebrow="Reference"
  source="BIBLIOGRAPHY.md"
  headings={headings}
>
  <Content />
</Doc>
