---
import { getCollection, render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import Figure from '../../components/Figure.astro';
import Callout from '../../components/Callout.astro';
import PhaseLoop from '../../components/diagrams/PhaseLoop.astro';
import { methodSteps } from '../../lib/content';

const base = import.meta.env.BASE_URL;
const [entry] = await getCollection('methodIndex');
if (!entry) throw new Error('method/README.md is missing');
const { Content, headings } = await render(entry);
const steps = await methodSteps(base);
---

<Doc
  title="The routine"
  description="Eight steps in order. Each page names the file you produce and the condition that lets you continue."
  eyebrow="Explanation"
  source="method/README.md"
  headings={headings}
  next={{ href: steps[0].href, label: `${steps[0].number}. ${steps[0].title}` }}
>
  <Content />

  <Figure caption="Every implementation phase is the same loop. The gate is the only exit, and you are the one who runs it.">
    <PhaseLoop />
  </Figure>

  <Callout kind="stop">
    <p>
      Do not open the solution tree until steps 0–4 exist as files. Do not paste an
      implementation prompt until the spec is written.
    </p>
  </Callout>

  <h2 id="the-steps">The steps</h2>
  <div class="cards not-prose">
    {
      steps.map((step) => (
        <a class="card" href={step.href}>
          <span class="card-num">{step.number}</span>
          <span class="card-main">
            <span class="card-title">{step.title}</span>
            <span class="card-goal">{step.goal}</span>
            <span class="card-stop">
              <b>Stop condition</b> {step.stop}
            </span>
          </span>
        </a>
      ))
    }
  </div>
</Doc>

<style>
  .cards {
    display: grid;
    gap: 0;
    border-top: var(--border-thin) solid var(--rule);
    margin-top: var(--space-4);
  }
  .card {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: var(--border-thin) solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .card:hover {
    background: var(--sheet);
  }
  .card-num {
    font-family: var(--font-mono);
    font-size: var(--size-lg);
    font-weight: 600;
    color: var(--accent);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .card-main {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: var(--size-lg);
    font-weight: 600;
  }
  .card-goal {
    font-size: var(--size-md);
    color: var(--ink-soft);
    line-height: var(--leading-normal);
  }
  .card-stop {
    font-family: var(--font-display);
    font-size: var(--size-sm);
    color: var(--ink-soft);
    line-height: var(--leading-normal);
    border-left: var(--border-thick) solid var(--pass);
    padding-left: var(--space-3);
  }
  .card-stop b {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    color: var(--pass);
    display: block;
  }
</style>
